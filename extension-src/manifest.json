{
  "manifest_version": 3,
  "name": "Golden Paw Animation Creation Tool",
  "short_name": "GP Animate",
  "version": "1.0.0",
  "description": "Turn video into sprite sheets, GIFs and JSON atlases, and edit sprite sheets. Offline, private, no uploads.",
  "homepage_url": "https://animate.goldenpaw.dog/",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Open the Golden Paw Animation Creation Tool",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  }
}
